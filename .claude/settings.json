{
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)"
    ],
    "deny": [
      "Read(./secrets/**)",
      "Read(./certs/**)"
    ]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.npmjs.org",
        "registry.yarnpkg.com"
      ],
      "allowUnixSockets": [
        "/var/run/docker.sock"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "//tmp"
      ],
      "denyRead": [
        "~/certs"
      ]
    },
    "excludedCommands": [
      "docker"
    ]
  },
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true
}
